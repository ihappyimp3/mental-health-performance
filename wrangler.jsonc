{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mental-health-performance",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mental-health-db",
      "database_id": "0d06a34f-cbd6-44ad-9bf5-aa2232381ecb",
      "migrations_dir": "migrations"
    }
  ]
}
